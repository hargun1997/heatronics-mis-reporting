# Copy this file to `.env` (or `server/.env`) and fill in the values.
# `.env` is gitignored — never commit real secrets.

# Anthropic (Claude) API key — used by the MIS classifier, the Tally screenshot
# reader, and the AI Expense Booking advisor.
# In Cloud Run, set this via Secret Manager or `gcloud run services update --update-env-vars`.
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# --- Connectors -------------------------------------------------------------
# Live-source credentials (Tally, Amazon, Shopify, …) are stored server-side,
# never in the browser. In Cloud Run they live in GCP Secret Manager; set the
# project so the connector store can reach it:
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
#
# Local dev without Secret Manager: credentials fall back to a gitignored
# JSON file. Override its location if you like:
# CONNECTOR_STORE_FILE=server/.connector-credentials.json
